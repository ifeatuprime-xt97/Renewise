# ═══════════════════════════════════════════════════════════════════════════════
# renewise Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Each section corresponds to a different component/process.

# ─────────────────────────────────────────────────────────────────────────────
# Phase 1: Main Telegram Bot (user/admin-facing)
# ─────────────────────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# SQLite database path (local dev / single-server deployments)
DATABASE_PATH=./data/renewise.db

# ── Neon / PostgreSQL (production) ───────────────────────────────────────────
# Set DATABASE_URL to your Neon connection string to use PostgreSQL instead of
# SQLite. When set, DATABASE_PATH is ignored entirely.
# Get your connection string from https://console.neon.tech → Connection Details
# → select "asyncpg" driver → copy the connection string.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Phase 2: TON Payment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Platform wallet that receives the combined 5.3% fee split
# Must be a valid TON address (EQ... or UQ... format)
PLATFORM_WALLET=EQD...your_platform_ton_address

# Address that receives PaymentLog messages for off-chain indexing.
# Can be the same as PLATFORM_WALLET or a dedicated chain-watcher address.
LOG_ADDRESS=EQD...your_log_ton_address

# ── Overpayment Refund — Trigger Wallet ──────────────────────────────────────
# A DEDICATED cheap hot wallet used ONLY to send Refund{} messages to vaults.
# This is NOT the platform fee-collection wallet.
# If this wallet is ever compromised, it can only trigger refunds the contract
# already validated — it CANNOT drain any funds. Safe to keep on server.
# Create a new wallet in Tonkeeper, fund with ~1 TON for gas, copy address + mnemonic.
TRIGGER_WALLET=UQ...your_trigger_wallet_address
TRIGGER_MNEMONIC=word1 word2 word3 ... word24

# Refund threshold in USD — overpayments below this are not refunded (default $1.00)
OVERPAYMENT_REFUND_THRESHOLD_USD=2.50

# Fee basis points (1 bps = 0.01%).
# Default: 200 (2.00% buyer-side) + 330 (3.30% admin-side) = 5.30% combined.
BUYER_FEE_BPS=200
ADMIN_FEE_BPS=330

# ─────────────────────────────────────────────────────────────────────────────
# Phase 2: Testnet Deployment (renewise/ton/deploy.py)
# ─────────────────────────────────────────────────────────────────────────────
# 24-word mnemonic for a testnet wallet with ≥ 0.3 TON
# Fund via: https://t.me/testgiver_ton_bot
DEPLOYER_MNEMONIC=word1 word2 word3 ... word24

# Testnet addresses to verify end-to-end split
ADMIN_ADDRESS=EQD...testnet_admin_address
PLATFORM_ADDRESS=EQD...testnet_platform_address

# ─────────────────────────────────────────────────────────────────────────────
# Phase 3: Chain-Watcher (Redis + RQ + TonCenter)
# ─────────────────────────────────────────────────────────────────────────────
# Redis connection URL (broker for RQ job queue)
REDIS_URL=redis://localhost:6379/0

# RQ queue name — must match across webhook server, workers, and scheduler
RQ_QUEUE_NAME=renewise

# ── TonCenter API keys — MUST be set before production use ───────────────────
#
# Without API keys you are rate-limited to 1 request/second on the free tier.
# The watcher polls every registered vault address every POLL_INTERVAL_SECONDS.
# At even modest subscriber counts (e.g. 20 active subscriptions polling every
# 15 s) you will hit the 1 req/s cap almost immediately, causing payment
# confirmation to stall and subscriptions to fail to activate on time.
#
# HOW TO GET KEYS:
#   1. Go to https://toncenter.com and create a free account
#   2. Generate one or more API keys from your dashboard
#   3. Each free key allows ~1 req/s; multiple keys are rotated automatically
#      on 429 responses by the built-in TonCenterKeyManager in toncenter.py
#
# TONCENTER_API_KEYS accepts a comma-separated list for multi-key rotation:
#   TONCENTER_API_KEYS=key1,key2,key3
#
# The legacy single-key variable is also accepted as a fallback:
#   TONCENTER_API_KEY=your_single_key
#
# Recommendation: register at least 2-3 keys for production resilience.
TONCENTER_API_KEYS=your_key_1,your_key_2,your_key_3

# Set to true to use testnet.toncenter.com instead of mainnet
TONCENTER_TESTNET=false

# Minimum block confirmations before treating a tx as final
# TON finalizes in ~5 seconds; 1 confirmation is sufficient for most use-cases.
MIN_CONFIRMATIONS=1

# Polling fallback interval in seconds (used when webhooks are unavailable)
POLL_INTERVAL_SECONDS=15

# ─────────────────────────────────────────────────────────────────────────────
# Phase 3: Webhook Server (receives TonCenter push notifications)
# ─────────────────────────────────────────────────────────────────────────────
# Bind address and port for the webhook server
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# Secret token TonCenter sends in X-Webhook-Token header for verification
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# Telegram username (without @) of your support account or support bot.
# When set, a "Contact Support" button is shown on the payment details screen.
# Example: SUPPORT_USERNAME=ReneWiseSupport
SUPPORT_USERNAME=

# ─────────────────────────────────────────────────────────────────────────────
# Phase 3: Subscription Lifecycle
# ─────────────────────────────────────────────────────────────────────────────
# Days after next_renewal_date before subscription is expired and user kicked
GRACE_PERIOD_DAYS=3

# Days before next_renewal_date to send the renewal reminder DM
REMINDER_WINDOW_DAYS=3

# ─────────────────────────────────────────────────────────────────────────────
# Phase 3: RQ Job Retry Settings
# ─────────────────────────────────────────────────────────────────────────────
# Number of automatic retries for a failed payment-processing job
JOB_MAX_RETRIES=5

# Base delay in seconds for exponential backoff
# Actual delay = JOB_RETRY_BASE_DELAY * 2^attempt (e.g., 10, 20, 40, 80, 160)
JOB_RETRY_BASE_DELAY=10

# Redis pub/sub channel for watcher → bot actions
BOT_ACTIONS_CHANNEL=renewise:bot_actions

# ─────────────────────────────────────────────────────────────────────────────
# Phase 4: Super-Admin Bot (platform operator control panel)
# ─────────────────────────────────────────────────────────────────────────────
# CRITICAL: This bot uses a DIFFERENT token from the main BOT_TOKEN above.
# Create a separate bot via @BotFather for super-admin operations.
SUPERADMIN_BOT_TOKEN=your_superadmin_bot_token_here

# Comma-separated list of Telegram user IDs allowed to use the super-admin bot.
# Any message from a user NOT in this list is silently ignored.
# Example: ALLOWED_SUPERADMIN_IDS=123456789,987654321,555444333
# Find your Telegram user ID by messaging @userinfobot on Telegram.
ALLOWED_SUPERADMIN_IDS=123456789,987654321

# ─────────────────────────────────────────────────────────────────────────────
# Developer Platform API  (renewise/services/platform.py + /api/developer/*)
# ─────────────────────────────────────────────────────────────────────────────
# No additional env vars are required for basic platform operation.
# Platforms are created via the Mini App UI; keys are stored in the database.
#
# Developer passkeys are bcrypt-hashed (cost factor 12) and never stored in
# plaintext. Rotation: Dashboard → Security → Change Passkey.
#
# Optional caps — uncomment to enable:
# PLATFORM_MAX_PER_USER=5        # max active platforms per Telegram user
# WEBHOOK_DELIVERY_TIMEOUT=5     # per-webhook HTTP timeout in seconds

# ─────────────────────────────────────────────────────────────────────────────
# Render keep-alive (free-tier web services)
# ─────────────────────────────────────────────────────────────────────────────
# Render sleeps free web services after 15 minutes with no inbound HTTP.
# Telegram polling is outbound, so the bots would go silent without this.
# On Render, PORT and RENDER_EXTERNAL_URL are set automatically — leave these
# blank locally. The process binds /health on $PORT and pings itself.
#
# KEEP_ALIVE=true
# KEEP_ALIVE_URL=https://your-bot.onrender.com
# Extra services to ping (comma-separated), e.g. the Mini App:
# KEEP_ALIVE_URLS=https://your-api.onrender.com/healthz
# KEEP_ALIVE_INTERVAL=600
# KEEP_ALIVE_PORT=          # defaults to $PORT

# ═══════════════════════════════════════════════════════════════════════════════
# PROCESS STARTUP QUICK REFERENCE
# ═══════════════════════════════════════════════════════════════════════════════
#
# All processes read this same .env file:
#
#   1. Main bot (Phase 1):
#      python -m renewise.bot
#
#   2. RQ workers (Phase 3 — start N workers for burst handling):
#      python -m renewise.watcher.worker --concurrency 4
#
#   3. Webhook server (Phase 3):
#      python -m renewise.watcher.webhook
#
#   4. Scheduler (Phase 3 — renewal reminders + grace enforcement):
#      python -m renewise.watcher.scheduler
#
#   5. Super-admin bot (Phase 4 — SEPARATE process from main bot):
#      python -m superadmin.bot
#
# ═══════════════════════════════════════════════════════════════════════════════
