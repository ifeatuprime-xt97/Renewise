# ═══════════════════════════════════════════════════════════════════════════════
# ReneWise — PRODUCTION Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env on your production server and fill in every value.
# Variables marked [REQUIRED] will cause the bot to crash or malfunction if
# left blank. Variables marked [RECOMMENDED] have safe defaults but should
# be set for a production deployment.
#
# SECURITY NOTES
# ──────────────
# - Never commit .env to version control (it is in .gitignore)
# - PLATFORM_WALLET: keep the mnemonic for this wallet completely offline
#   (hardware wallet or paper backup). The bot NEVER needs it.
# - TRIGGER_MNEMONIC: this IS stored on the server. It controls a cheap hot
#   wallet (~2 TON) used only to trigger on-chain refunds. If leaked, an
#   attacker can only trigger refunds the contract already validated — they
#   cannot steal platform fees or admin payouts.
# - SUPERADMIN_BOT_TOKEN: treat like a password. Anyone with this token can
#   see all platform data and change global fee settings.
# ═══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# BOTS
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Main user-facing bot token from @BotFather
BOT_TOKEN=

# [REQUIRED] Separate superadmin control panel bot token from @BotFather
# Must be a DIFFERENT bot from BOT_TOKEN
SUPERADMIN_BOT_TOKEN=

# [REQUIRED] Comma-separated Telegram user IDs for superadmin access
# Find your ID: message @userinfobot on Telegram
# Example: 123456789,987654321
ALLOWED_SUPERADMIN_IDS=


# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED for Neon/PostgreSQL] Neon connection string — used in production.
# Get this from https://console.neon.tech → your project → Connection Details
# → select the "asyncpg" driver → copy the full connection string.
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# When DATABASE_URL is set, DATABASE_PATH is ignored.
DATABASE_URL=

# [OPTIONAL] SQLite fallback path — only used when DATABASE_URL is not set.
# Leave this as-is unless you are running a single-server SQLite deployment.
DATABASE_PATH=/var/data/renewise/renewise.db


# ─────────────────────────────────────────────────────────────────────────────
# TON WALLETS
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Platform fee collection wallet
# Receives admin_fee + buyer_fee (~5.3%) from every subscription payment
# Keep the mnemonic for this wallet OFFLINE — the bot never needs it
# Use UQ... (non-bounceable) format
PLATFORM_WALLET=

# [REQUIRED] Address for PaymentLog off-chain indexing messages
# Can be the same as PLATFORM_WALLET or a dedicated monitoring address
LOG_ADDRESS=

# [REQUIRED] Trigger wallet address — dedicated hot wallet for Refund{} messages
# This wallet ONLY sends Refund{} to vaults when a member overpays
# Create a fresh wallet in Tonkeeper, fund with ~2 TON for gas
# Use UQ... (non-bounceable) format
TRIGGER_WALLET=

# [REQUIRED] 24-word mnemonic for the trigger wallet
# This is the ONLY mnemonic stored on the server
# The trigger wallet only holds ~2 TON — safe to keep here
TRIGGER_MNEMONIC=


# ─────────────────────────────────────────────────────────────────────────────
# PLATFORM FEES
# ─────────────────────────────────────────────────────────────────────────────

# [RECOMMENDED] Buyer-side fee in basis points (100 bps = 1.00%)
# Default: 200 (2.00%) — charged on top of the subscription price
BUYER_FEE_BPS=200

# [RECOMMENDED] Admin-side fee in basis points (100 bps = 1.00%)
# Default: 330 (3.30%) — deducted from the admin's share
ADMIN_FEE_BPS=330

# [RECOMMENDED] Minimum overpayment in USD to trigger the automatic refund flow
# Overpayments below this are absorbed (too small to be worth the gas cost)
# Default: 1.00 — adjust based on typical TON gas fees
OVERPAYMENT_REFUND_THRESHOLD_USD=2.50


# ─────────────────────────────────────────────────────────────────────────────
# TONCENTER API
# ─────────────────────────────────────────────────────────────────────────────

# [RECOMMENDED] Comma-separated TonCenter API keys
# Without keys: rate-limited to 1 req/s (breaks under any real load)
# Get keys free at https://toncenter.com
# Use multiple keys for automatic rotation on 429 rate-limit responses
TONCENTER_API_KEYS=

# [REQUIRED] Set to false for mainnet
TONCENTER_TESTNET=false

# [RECOMMENDED] Confirmations before treating a tx as final
# TON finalises in ~5 seconds; 1 is safe for subscriptions
MIN_CONFIRMATIONS=1

# [RECOMMENDED] Vault polling interval in seconds (in-process watcher mode)
# Lower = faster payment detection, higher = fewer API calls
# 5s is recommended for production with API keys (near-instant confirmation)
# Use 15s only if you're hitting rate limits
POLL_INTERVAL_SECONDS=5


# ─────────────────────────────────────────────────────────────────────────────
# REDIS + RQ  (multi-process mode only — NOT needed for python run.py)
# ─────────────────────────────────────────────────────────────────────────────
# Only needed when running the separate watcher/worker/scheduler stack.
# Not required when using python run.py (in-process watcher mode).

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# RQ queue name — must match across webhook server, workers, and scheduler
RQ_QUEUE_NAME=renewise

# Redis pub/sub channel for watcher → bot actions bridge
BOT_ACTIONS_CHANNEL=renewise:bot_actions

# Max automatic retries for a failed payment-processing job
JOB_MAX_RETRIES=5

# Base delay in seconds for exponential backoff between retries
# Actual delays: base * 2^attempt — e.g. 10s, 20s, 40s, 80s, 160s
JOB_RETRY_BASE_DELAY=10


# ─────────────────────────────────────────────────────────────────────────────
# WEBHOOK SERVER  (production only)
# ─────────────────────────────────────────────────────────────────────────────
# TonCenter can push transaction notifications to this server instead of polling.
# Eliminates polling latency — payments confirmed in <1s.

# Bind address for the webhook server
WEBHOOK_HOST=0.0.0.0

# Port for the webhook server (must be reachable by TonCenter)
WEBHOOK_PORT=8080

# [RECOMMENDED] Secret token for webhook signature verification
# TonCenter sends this in the X-Webhook-Token header
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# [OPTIONAL] Telegram username (without @) of your support account or bot.
# [OPTIONAL] Telegram username (without @) of your support account or bot.
# When set, a "💬 Contact Support" button appears on the payment screen.
# Example: ReneWiseSupport
SUPPORT_USERNAME=ReneWiseSupport
GRACE_PERIOD_DAYS=3
REMINDER_WINDOW_DAYS=3
WALLET_CHANGE_DELAY_HOURS=24


# ─────────────────────────────────────────────────────────────────────────────
# CoinMarketCap (optional price feed fallback)
# ─────────────────────────────────────────────────────────────────────────────
# If CoinGecko is unavailable, the bot falls back to CoinMarketCap.
# Leave blank to skip CMC and use only CoinGecko + stale cache fallback.
CMC_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION STARTUP
# ═══════════════════════════════════════════════════════════════════════════════
#
# Option A — Single process (simpler, suitable for moderate traffic):
#
#   python run.py
#
#   Starts main bot + superadmin bot + in-process payment watcher.
#   No Redis required. Payment watcher polls TonCenter directly.
#
#
# Option B — Multi-process (recommended for high traffic):
#
#   # 1. Main bot
#   python -m renewise.bot
#
#   # 2. RQ workers (scale N based on volume)
#   python -m renewise.watcher.worker --concurrency 4
#
#   # 3. Webhook server (TonCenter push notifications)
#   python -m renewise.watcher.webhook
#
#   # 4. Scheduler (renewal reminders + grace enforcement)
#   python -m renewise.watcher.scheduler
#
#   # 5. Superadmin bot
#   python -m renewise.superadmin.bot
#
#
# CHECKLIST BEFORE GOING LIVE
# ────────────────────────────
# [ ] BOT_TOKEN and SUPERADMIN_BOT_TOKEN set and bots created in BotFather
# [ ] Group Privacy mode DISABLED for the main bot in BotFather
# [ ] DATABASE_URL set to Neon connection string (or DATABASE_PATH on persistent volume)
# [ ] Neon project created, connection string copied from console.neon.tech
# [ ] PLATFORM_WALLET set — mnemonic kept offline
# [ ] TRIGGER_WALLET created in Tonkeeper, funded with ~2 TON
# [ ] TRIGGER_MNEMONIC copied from Tonkeeper
# [ ] TONCENTER_API_KEYS set (at least one key)
# [ ] TONCENTER_TESTNET=false
# [ ] WEBHOOK_SECRET generated and set
# [ ] SUPPORT_USERNAME set to your support bot/account
# [ ] Contract built: cd contracts && npm install && npm run build
# [ ] .env file permissions: chmod 600 .env
# [ ] Render: start command is `python run.py` (binds $PORT + self-pings)
# [ ] Render: optional KEEP_ALIVE_URLS includes the Mini App /healthz URL
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Render keep-alive
# ─────────────────────────────────────────────────────────────────────────────
# Required on Render free tier. PORT and RENDER_EXTERNAL_URL are injected
# by Render — do not set PORT yourself. Self-ping interval must stay under
# 15 minutes or the web service will spin down and the bots go silent.
KEEP_ALIVE=true
# Override if RENDER_EXTERNAL_URL is missing or you want a specific path:
# KEEP_ALIVE_URL=https://your-bot.onrender.com/health
# Also ping the Mini App (separate Render service):
# KEEP_ALIVE_URLS=https://your-api.onrender.com/healthz
KEEP_ALIVE_INTERVAL=600

# ─────────────────────────────────────────────────────────────────────────────
# Split deployment — Vercel (Mini App) + Render (Bot)
# ─────────────────────────────────────────────────────────────────────────────
# Set on Vercel: both INTERNAL_API_URL and INTERNAL_API_SECRET
# Set on Render: only INTERNAL_API_SECRET (same value)
#
# INTERNAL_API_URL: your Render bot service public URL
#   e.g. https://renewise-bot.onrender.com
INTERNAL_API_URL=

# INTERNAL_API_SECRET: shared secret protecting the internal endpoint
#   Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_SECRET=9018d9e03a881e1f68fe5be96f849194ead8b28cba75f0a8beb22bc8860599eb
